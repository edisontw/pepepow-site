---
import { verifiedLinks } from '../data/verified-links';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const lightEndpoint = verifiedLinks.pepewLightStatusApi;
const monitorEndpoint = verifiedLinks.explorerPublicSummaryApi;
const titleId = compact ? 'home-network-pulse-title' : 'network-pulse-title';
---

<section
  class:list={['network-pulse', { 'network-pulse-compact': compact }]}
  data-network-pulse
  data-compact={compact ? 'true' : 'false'}
  data-light-endpoint={lightEndpoint}
  data-monitor-endpoint={monitorEndpoint}
  aria-labelledby={titleId}
>
  <header class="network-pulse-header">
    <div>
      <p class="eyebrow">Network Pulse</p>
      <h2 id={titleId}>{compact ? 'Live network heartbeat.' : 'Current network summary.'}</h2>
    </div>
    <span class="network-pulse-status is-checking" data-pulse-status aria-live="polite">
      Checking…
    </span>
  </header>

  {compact ? (
    <div class="network-pulse-grid">
      <div class="network-pulse-metric">
        <span>Block height</span>
        <strong data-pulse-field="height">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>Wallet service</span>
        <strong data-pulse-field="light-api">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>ElectrumX</span>
        <strong data-pulse-field="electrumx">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>Status age</span>
        <strong data-pulse-field="status-age">—</strong>
      </div>
    </div>
  ) : (
    <div class="network-pulse-grid">
      <div class="network-pulse-metric">
        <span>Block height</span>
        <strong data-pulse-field="height">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>Hashrate</span>
        <strong data-pulse-field="hashrate">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>Masternodes</span>
        <strong data-pulse-field="masternodes">—</strong>
      </div>
      <div class="network-pulse-metric">
        <span>Last block</span>
        <strong data-pulse-field="last-block">—</strong>
      </div>
      <div class="network-pulse-metric pulse-secondary">
        <span>8 min block avg.</span>
        <strong data-pulse-field="block-time">—</strong>
      </div>
      <div class="network-pulse-metric pulse-secondary">
        <span>Services</span>
        <strong data-pulse-field="services">—</strong>
      </div>
    </div>
  )}

  <p class="network-pulse-meta" data-pulse-meta aria-live="polite">
    {compact
      ? 'Live status loads from the cached PEPEW Light service.'
      : 'Block height comes from PEPEW Light when available; broader metrics come from the cached Explorer monitor.'}
  </p>

  <div class="network-pulse-links">
    <span>Proof of Work: <strong>HooHash V110</strong></span>
    <a href="/network/">Network details</a>
    <a href={verifiedLinks.pepewLight}>PEPEW Light ↗</a>
    <a href={verifiedLinks.explorer}>Explorer ↗</a>
  </div>
</section>

<script>
  const formatInteger = (value) => {
    const number = Number(value);
    return Number.isFinite(number) ? Math.round(number).toLocaleString() : '—';
  };

  const formatSeconds = (value) => {
    const number = Number(value);
    if (!Number.isFinite(number)) return '—';
    if (number < 60) return Math.max(0, Math.round(number)) + ' s';
    const minutes = number / 60;
    if (minutes < 60) return (minutes < 10 ? minutes.toFixed(1) : Math.round(minutes)) + ' min';
    const hours = minutes / 60;
    return (hours < 10 ? hours.toFixed(1) : Math.round(hours)) + ' h';
  };

  const formatStatus = (value) => {
    const text = String(value || 'unknown').replaceAll('_', ' ');
    return text.charAt(0).toUpperCase() + text.slice(1);
  };

  const bindPulse = (root) => {
    if (!(root instanceof HTMLElement) || root.dataset.pulseBound === 'true') return;
    root.dataset.pulseBound = 'true';

    const compact = root.dataset.compact === 'true';
    const lightEndpoint = root.dataset.lightEndpoint;
    const monitorEndpoint = root.dataset.monitorEndpoint;
    const statusNode = root.querySelector('[data-pulse-status]');
    const metaNode = root.querySelector('[data-pulse-meta]');

    let lightData = null;
    let monitorData = null;
    let lightHealthy = false;
    let monitorHealthy = false;

    const setField = (name, value) => {
      const node = root.querySelector('[data-pulse-field="' + name + '"]');
      if (node) node.textContent = value;
    };

    const setState = (state, label) => {
      if (!statusNode) return;
      statusNode.textContent = label;
      statusNode.className = 'network-pulse-status is-' + state;
      root.dataset.pulseState = state;
    };

    const renderCompact = () => {
      const electrumx = lightData?.electrumx || {};
      setField('height', formatInteger(electrumx.height));
      setField('light-api', lightHealthy ? 'Online' : 'Unavailable');
      setField('electrumx', electrumx.connected ? 'Connected' : 'Disconnected');
      setField('status-age', formatSeconds(lightData?.cache_age_seconds));

      if (lightHealthy && electrumx.connected) {
        const age = Number(lightData?.cache_age_seconds);
        const delayed = Number.isFinite(age) && age > 60;
        setState(delayed ? 'delayed' : 'live', delayed ? 'Delayed' : 'Live');
      } else {
        setState('unavailable', 'Unavailable');
      }

      if (metaNode) {
        const age = formatSeconds(lightData?.cache_age_seconds);
        metaNode.textContent = lightHealthy
          ? 'PEPEW Light / ElectrumX · data age ' + age + ' · refreshes every 60 s.'
          : 'Live wallet-service status is temporarily unavailable. The rest of the site remains available.';
      }
    };

    const renderFull = () => {
      const lightHeight = lightHealthy ? lightData?.electrumx?.height : null;
      const monitorHeight = monitorData?.height;
      setField('height', formatInteger(lightHeight ?? monitorHeight));
      setField('hashrate', monitorData?.hashrate_display || '—');
      setField(
        'masternodes',
        monitorData
          ? formatInteger(monitorData.masternode_enabled) + ' / ' + formatInteger(monitorData.masternode_total)
          : '—',
      );
      setField('last-block', formatSeconds(monitorData?.last_block_age_seconds));
      setField('block-time', formatSeconds(monitorData?.avg_block_time_8m));
      setField('services', monitorData ? formatStatus(monitorData.services?.overall_status) : '—');

      const freshness = monitorData?.freshness || {};
      const monitorDelayed =
        Boolean(monitorData?.stale) ||
        (monitorData && freshness.overall_status !== 'normal') ||
        (monitorData && freshness.snapshot_status !== 'normal');

      if (!lightHealthy && !monitorHealthy) {
        setState('unavailable', 'Unavailable');
      } else if (!lightHealthy || !monitorHealthy) {
        setState('delayed', 'Limited');
      } else if (monitorDelayed) {
        setState('delayed', 'Delayed');
      } else {
        setState('live', 'Live');
      }

      if (metaNode) {
        const parts = [];
        if (lightHealthy) {
          parts.push('height from PEPEW Light');
        } else if (monitorHealthy) {
          parts.push('height from Explorer fallback');
        }
        if (monitorHealthy) {
          const age = Number(freshness.snapshot_age_seconds);
          parts.push(
            Number.isFinite(age)
              ? 'network data age ' + formatSeconds(age)
              : 'Explorer network data',
          );
        } else {
          parts.push('broader network metrics unavailable');
        }
        parts.push('height refresh 60 s');
        parts.push('network metrics refresh 120 s');
        metaNode.textContent = parts.join(' · ');
      }
    };

    const render = () => {
      if (compact) renderCompact();
      else renderFull();
    };

    const fetchJson = async (endpoint) => {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);
      try {
        const response = await fetch(endpoint, {
          method: 'GET',
          cache: 'no-store',
          credentials: 'omit',
          signal: controller.signal,
        });
        if (!response.ok) throw new Error('request failed');
        return await response.json();
      } finally {
        window.clearTimeout(timeout);
      }
    };

    const refreshLight = async () => {
      if (!lightEndpoint || document.visibilityState === 'hidden') return;
      try {
        const data = await fetchJson(lightEndpoint);
        lightData = data;
        lightHealthy = Boolean(data?.ok && data?.electrumx?.connected);
      } catch {
        lightHealthy = false;
      }
      render();
    };

    const refreshMonitor = async () => {
      if (compact || !monitorEndpoint || document.visibilityState === 'hidden') return;
      try {
        monitorData = await fetchJson(monitorEndpoint);
        monitorHealthy = true;
      } catch {
        monitorHealthy = false;
      }
      render();
    };

    refreshLight();
    if (!compact) refreshMonitor();

    const lightInterval = window.setInterval(refreshLight, 60000);
    const monitorInterval = compact ? null : window.setInterval(refreshMonitor, 120000);

    window.addEventListener(
      'pagehide',
      () => {
        window.clearInterval(lightInterval);
        if (monitorInterval !== null) window.clearInterval(monitorInterval);
      },
      { once: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        refreshLight();
        if (!compact) refreshMonitor();
      }
    });
  };

  document.querySelectorAll('[data-network-pulse]').forEach(bindPulse);
</script>
