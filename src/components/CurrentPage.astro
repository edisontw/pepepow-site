---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IllustratedPageHeader from './IllustratedPageHeader.astro';
import { verifiedLinks } from '../data/verified-links';

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const pageConfigs: Record<string, {
  title: string;
  eyebrow: string;
  intro: string;
  actions: Array<{ label: string; href: string; primary?: boolean }>;
}> = {
  about: {
    title: 'About PEPEPOW',
    eyebrow: 'PEPEPOW',
    intro: 'A concise guide to what PEPEPOW is, how the network has evolved, and where to verify its software, history, and public sources.',
    actions: [
      { label: 'Explore Network', href: '/network/', primary: true },
      { label: 'Development Roadmap', href: '/roadmap/' },
      { label: 'Core source', href: verifiedLinks.coreRepository },
      { label: 'Announcements', href: '/announcements/' },
    ],
  },
  roadmap: {
    title: 'PEPEPOW Development Roadmap',
    eyebrow: 'Build · maintain · extend',
    intro: 'A current view of completed, in-progress, and planned PEPEPOW infrastructure and ecosystem work.',
    actions: [
      { label: 'About PEPEPOW', href: '/about/', primary: true },
      { label: 'Announcements', href: '/announcements/' },
      { label: 'Core source', href: verifiedLinks.coreRepository },
    ],
  },
  wallet: {
    title: 'PEPEPOW Wallets',
    eyebrow: 'Wallets',
    intro: 'Choose a PEPEW wallet, verify the source before you use it, and follow current guidance for backups, updates, and recovery.',
    actions: [
      { label: 'Open PEPEW Light', href: verifiedLinks.pepewLightWallet, primary: true },
      { label: 'Core releases', href: verifiedLinks.coreReleases },
      { label: 'Android releases', href: verifiedLinks.androidWalletReleases },
    ],
  },
  mining: {
    title: 'PEPEPOW Mining',
    eyebrow: 'Mining',
    intro: 'Start mining PEPEW with current HooHash V110 software, pool references, setup steps, and safety checks.',
    actions: [
      { label: 'HTN Miner', href: verifiedLinks.htnMiner, primary: true },
      { label: 'Community Pool', href: verifiedLinks.communityPool },
      { label: 'Lab Pool', href: verifiedLinks.labPool },
    ],
  },
  masternode: {
    title: 'PEPEPOW Masternode',
    eyebrow: 'Masternode',
    intro: 'Set up and maintain a PEPEPOW masternode with current collateral tiers, operational checks, reward context, and security guidance.',
    actions: [
      { label: 'Network status', href: '/network/', primary: true },
      { label: 'Core releases', href: verifiedLinks.coreReleases },
      { label: 'Explorer', href: verifiedLinks.explorerNetwork },
    ],
  },
  market: {
    title: 'PEPEPOW Market',
    eyebrow: 'Market',
    intro: 'Find current PEPEW market references and confirmed venues, with practical context on exchange and third-party risk.',
    actions: [
      { label: 'Explorer', href: verifiedLinks.explorer, primary: true },
      { label: 'NonKYC', href: verifiedLinks.nonKycMarket },
      { label: 'NestEx', href: verifiedLinks.nestExMarket },
    ],
  },
};

const visualHeaders: Record<string, string> = {
  about: '/media/visual/handdrawn/headers/header-about-v1.webp',
  wallet: '/media/visual/handdrawn/headers/header-wallets-v1.webp',
  mining: '/media/visual/handdrawn/headers/header-mining-v1.webp',
  masternode: '/media/visual/handdrawn/headers/header-masternode-v1.webp',
  market: '/media/visual/handdrawn/headers/header-market-v1.webp',
};

const visualSpots: Record<string, string> = {
  about: '/media/visual/handdrawn/spots/spot-about-journey-v1.webp',
  mining: '/media/visual/handdrawn/spots/spot-mining-setup-v1.webp',
  market: '/media/visual/handdrawn/spots/spot-market-verified-venues-v1.webp',
};

const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
const config = pageConfigs[slug] ?? {
  title: entry.data.title,
  eyebrow: 'PEPEPOW',
  intro: entry.data.description || 'Current PEPEPOW community information and operational references.',
  actions: [],
};

const reviewed = (entry.data.updated ?? entry.data.date).toISOString().slice(0, 10);
const tocHeadings = headings.filter((heading) => heading.depth === 2).slice(0, 10);
const description = entry.data.description || config.intro;
const headerImage = visualHeaders[slug];
const spotImage = visualSpots[slug];
const usesHanddrawnTheme = ['about', 'roadmap', 'wallet', 'mining', 'masternode', 'market'].includes(slug);
const hasToc = tocHeadings.length >= 3;
---

<BaseLayout title={entry.data.title} description={description} theme={usesHanddrawnTheme ? 'handdrawn' : 'default'}>
  <article class="current-page">
    {headerImage ? (
      <IllustratedPageHeader
        eyebrow={config.eyebrow}
        title={config.title}
        intro={config.intro}
        image={headerImage}
        actions={config.actions}
        reviewed={`Current page · reviewed ${reviewed}`}
      />
    ) : (
      <header class="current-page-header">
        <p class="eyebrow">{config.eyebrow}</p>
        <h1>{config.title}</h1>
        <p class="current-page-lede">{config.intro}</p>
        {config.actions.length > 0 && (
          <div class="actions current-page-actions">
            {config.actions.map((action) => (
              <a class={action.primary ? 'button' : 'button secondary'} href={action.href}>
                {action.label}
              </a>
            ))}
          </div>
        )}
        <p class="reviewed-date">Current page · reviewed {reviewed}</p>
      </header>
    )}

    <div class:list={{ 'current-page-layout': true, 'current-page-layout--single': !hasToc }}>
      {hasToc && (
        <nav class="page-toc" aria-label="On this page">
          <p class="page-toc-title">On this page</p>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="current-page-body">
        {spotImage && (
          <div class="current-page-spot" aria-hidden="true">
            <img src={spotImage} alt="" loading="lazy" decoding="async" />
          </div>
        )}
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
