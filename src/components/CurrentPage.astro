---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IllustratedPageHeader from './IllustratedPageHeader.astro';

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const pageConfigs: Record<string, {
  title: string;
  eyebrow: string;
  intro: string;
  actions: Array<{ label: string; href: string; primary?: boolean }>;
}> = {
  about: {
    title: 'About PEPEPOW',
    eyebrow: 'PEPEPOW',
    intro: 'What PEPEPOW is, how the network evolved, and where to verify its current software, history, and community references.',
    actions: [
      { label: 'Explore Network', href: '/network/', primary: true },
      { label: 'Core source', href: 'https://github.com/MattF42/PePe-core' },
      { label: 'Announcements', href: '/announcements/' },
    ],
  },
  wallet: {
    title: 'PEPEPOW Wallets',
    eyebrow: 'Wallets',
    intro: 'Choose a PEPEW wallet, verify official sources, and follow current backup, update, and recovery guidance.',
    actions: [
      { label: 'Open PEPEW Light', href: 'https://light.pepepow.net/wallet/', primary: true },
      { label: 'Core releases', href: 'https://github.com/MattF42/PePe-core/releases' },
      { label: 'Android releases', href: 'https://github.com/edisontw/pepepow-android-wallet-v2/releases' },
    ],
  },
  mining: {
    title: 'PEPEPOW Mining',
    eyebrow: 'Mining',
    intro: 'Current HooHash V110 mining entry points, miner software, pool references, and setup guidance.',
    actions: [
      { label: 'HTN Miner', href: 'https://htn.foztor.net/', primary: true },
      { label: 'Community Pool', href: 'https://community-pool.pepepow.org/' },
      { label: 'Lab Pool', href: 'https://pool.pepepow.net/' },
    ],
  },
  masternode: {
    title: 'PEPEPOW Masternode',
    eyebrow: 'Masternode',
    intro: 'Current masternode requirements, setup flow, operational checks, reward context, and security reminders.',
    actions: [
      { label: 'Network status', href: '/network/', primary: true },
      { label: 'Core releases', href: 'https://github.com/MattF42/PePe-core/releases' },
      { label: 'Explorer', href: 'https://explorer.pepepow.org/network' },
    ],
  },
  market: {
    title: 'PEPEPOW Market',
    eyebrow: 'Market',
    intro: 'Current PEPEW market references, confirmed venues, and exchange-risk context without price predictions.',
    actions: [
      { label: 'Explorer market data', href: 'https://explorer.pepepow.org/', primary: true },
      { label: 'NonKYC', href: 'https://nonkyc.io/market/PEPEW_USD' },
      { label: 'NestEx', href: 'https://trade.nestex.one/spot/PEPEW' },
    ],
  },
};

const visualHeaders: Record<string, string> = {
  wallet: '/media/visual/handdrawn/headers/header-wallets-v1.webp',
  mining: '/media/visual/handdrawn/headers/header-mining-v1.webp',
  masternode: '/media/visual/handdrawn/headers/header-masternode-v1.webp',
};

const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
const config = pageConfigs[slug] ?? {
  title: entry.data.title,
  eyebrow: 'PEPEPOW',
  intro: entry.data.description || 'Current PEPEPOW community information and operational references.',
  actions: [],
};

const reviewed = (entry.data.updated ?? entry.data.date).toISOString().slice(0, 10);
const tocHeadings = headings.filter((heading) => heading.depth === 2).slice(0, 10);
const description = entry.data.description || config.intro;
const headerImage = visualHeaders[slug];
---

<BaseLayout title={entry.data.title} description={description} theme={headerImage ? 'handdrawn' : 'default'}>
  <article class="current-page">
    {headerImage ? (
      <IllustratedPageHeader
        eyebrow={config.eyebrow}
        title={config.title}
        intro={config.intro}
        image={headerImage}
        actions={config.actions}
        reviewed={`Current page · reviewed ${reviewed}`}
      />
    ) : (
      <header class="current-page-header">
        <p class="eyebrow">{config.eyebrow}</p>
        <h1>{config.title}</h1>
        <p class="current-page-lede">{config.intro}</p>
        {config.actions.length > 0 && (
          <div class="actions current-page-actions">
            {config.actions.map((action) => (
              <a class={action.primary ? 'button' : 'button secondary'} href={action.href}>
                {action.label}
              </a>
            ))}
          </div>
        )}
        <p class="reviewed-date">Current page · reviewed {reviewed}</p>
      </header>
    )}

    <div class="current-page-layout">
      {tocHeadings.length >= 3 && (
        <nav class="page-toc" aria-label="On this page">
          <p class="page-toc-title">On this page</p>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="current-page-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
