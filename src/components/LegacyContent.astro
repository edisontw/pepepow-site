---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const { entry } = Astro.props;
const { Content } = await render(entry);

const isPage = entry.collection === 'pages';
const isHistoricalPost =
  entry.data.migration_review &&
  (entry.collection === 'announcements' || entry.collection === 'articles');
const isLegacyTechnicalArticle =
  entry.data.migration_review && entry.collection === 'articles';
const description = entry.data.description || 'PEPEPOW community content.';
const published = entry.data.date instanceof Date
  ? entry.data.date.toISOString().slice(0, 10)
  : String(entry.data.date);
---

<BaseLayout title={entry.data.title} description={description}>
  <article class="legacy-entry">
    {!isPage && (
      <header class="legacy-entry-header">
        <p class="legacy-entry-meta">
          <time datetime={published}>{published}</time>
          {entry.data.categories?.length > 0 && (
            <span> · {entry.data.categories.join(' · ')}</span>
          )}
        </p>
        <h1>{entry.data.title}</h1>
      </header>
    )}
    {isHistoricalPost && (
      <aside class="archive-note historical-entry-notice">
        <strong>Historical content:</strong>
        This post is preserved from the PEPEPOW archive and reflects the software, services, market,
        or network conditions at its original publication date. For current operational guidance,
        use the <a href="/wallet/">Wallet</a>, <a href="/mining/">Mining</a>,
        <a href="/masternode/">Masternode</a>, <a href="/market/">Market</a>, and
        <a href="https://explorer.pepepow.org/">Explorer</a> pages.
      </aside>
    )}
    {isLegacyTechnicalArticle && (
      <aside class="archive-note technical-safety-notice">
        <strong>Legacy technical guide:</strong>
        Do not run archived commands verbatim on a current wallet or node. Software versions,
        block heights, peer IPs, download URLs, file paths, and third-party services may be obsolete.
        Before changing wallet or blockchain files, stop the wallet cleanly and keep a separate
        backup of <code>wallet.dat</code>. Never share private keys or recovery phrases, and verify
        current instructions before using destructive recovery commands or remote install scripts.
      </aside>
    )}
    <Content />
  </article>
</BaseLayout>
