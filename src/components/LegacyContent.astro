---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { verifiedLinks } from '../data/verified-links';

const { entry } = Astro.props;
const { Content } = await render(entry);

const isPage = entry.collection === 'pages';
const isHistoricalPost =
  entry.data.migration_review &&
  (entry.collection === 'announcements' || entry.collection === 'articles');
const isLegacyTechnicalArticle =
  entry.data.migration_review && entry.collection === 'articles';
const description = entry.data.description || 'PEPEPOW community content.';
const published = entry.data.date instanceof Date
  ? entry.data.date.toISOString().slice(0, 10)
  : String(entry.data.date);
---

<BaseLayout title={entry.data.title} description={description} theme="handdrawn">
  <article class="legacy-entry">
    {!isPage && (
      <header class="legacy-entry-header">
        <p class="legacy-entry-meta">
          <time datetime={published}>{published}</time>
          {entry.data.categories?.length > 0 && (
            <span> · {entry.data.categories.join(' · ')}</span>
          )}
        </p>
        <h1>{entry.data.title}</h1>
      </header>
    )}
    {isHistoricalPost && (
      <aside class="archive-note historical-entry-notice">
        <strong>Historical content:</strong>
        This post is preserved with its original publication context. Software, services, markets,
        and network conditions may have changed since then. Before following technical or financial
        information, check the current <a href="/wallet/">Wallet</a>, <a href="/mining/">Mining</a>,
        <a href="/masternode/">Masternode</a>, <a href="/market/">Market</a>, or
        <a href={verifiedLinks.explorer}>Explorer</a> pages.
      </aside>
    )}
    {isLegacyTechnicalArticle && (
      <aside class="archive-note technical-safety-notice">
        <strong>Legacy technical guide:</strong>
        Do not copy archived commands directly into a current wallet or node. Versions, block
        heights, peer addresses, download URLs, file paths, and third-party services may be obsolete.
        Before changing wallet or blockchain files, stop the wallet cleanly and keep a separate
        backup of <code>wallet.dat</code>. Never share private keys or recovery phrases, and verify
        current instructions before using destructive recovery steps or remote install scripts.
      </aside>
    )}
    <Content />
  </article>
</BaseLayout>
