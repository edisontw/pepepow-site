---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  theme?: 'default' | 'handdrawn';
  noindex?: boolean;
}

const {
  title = 'PEPEPOW',
  description = 'PEPEPOW community-powered Proof of Work.',
  theme = 'default',
  noindex = false,
} = Astro.props;

const handdrawnTheme = theme === 'handdrawn';
const defaultColorTheme = handdrawnTheme ? 'light' : 'dark';

const pageTitle = title === 'PEPEPOW' ? title : `${title} | PEPEPOW`;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.url.origin);
const primaryNavItems = [
  { href: '/network/', label: 'Network' },
  { href: '/wallet/', label: 'Wallets' },
  { href: '/mining/', label: 'Mining' },
  { href: '/masternode/', label: 'Masternode' },
  { href: '/market/', label: 'Market' },
  { href: '/announcements/', label: 'News' },
];

const utilityNavItems = [
  { href: '/about/', label: 'About' },
  { href: '/learn/', label: 'Learn' },
  { href: '/lens/', label: 'Lens' },
  { href: '/tools/', label: 'Tools' },
  { href: '/community/', label: 'Community' },
  { href: '/search/', label: 'Search' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<!doctype html>
<html lang="en" class:list={{ 'handdrawn-root': handdrawnTheme }} data-color-theme={defaultColorTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply an explicitly saved preference before the page stylesheet is painted.
      try {
        const saved = localStorage.getItem('pepepow-color-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.colorTheme = saved;
        }
      } catch {
        // Storage can be disabled; the original page theme remains the fallback.
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={handdrawnTheme ? '#f7f5eb' : '#111411'} />
    <link rel="icon" type="image/webp" href="/media/legacy/2025logo.webp" />
    <link rel="apple-touch-icon" href="/media/legacy/2025logo.webp" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'handdrawn-theme': handdrawnTheme }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a
        class="brand"
        href="/"
        aria-label="PEPEPOW home"
        aria-current={currentPath === '/' ? 'page' : undefined}
      >
        <img
          class="brand-logo"
          src="/media/legacy/2025logo.webp"
          alt=""
          width="44"
          height="42"
          decoding="async"
        />
        <span>PEPEPOW</span>
      </a>
      <div class="site-navigation">
        <nav class="primary-nav" aria-label="Primary">
          {primaryNavItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <nav class="utility-nav" aria-label="Utility">
          {utilityNavItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label={defaultColorTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'}
        title={defaultColorTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'}
      >
        <span class="theme-toggle-icon" data-theme-icon aria-hidden="true">{defaultColorTheme === 'dark' ? '☀' : '☾'}</span>
        <span data-theme-label>{defaultColorTheme === 'dark' ? 'Light' : 'Dark'}</span>
      </button>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>PEPEPOW · Open source · Community maintained</p>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const syncThemeControl = () => {
        const isDark = root.dataset.colorTheme === 'dark';
        const next = isDark ? 'light' : 'dark';
        if (toggle) {
          const action = 'Switch to ' + next + ' theme';
          toggle.setAttribute('aria-label', action);
          toggle.title = action;
          const icon = toggle.querySelector('[data-theme-icon]');
          const label = toggle.querySelector('[data-theme-label]');
          if (icon) icon.textContent = isDark ? '☀' : '☾';
          if (label) label.textContent = isDark ? 'Light' : 'Dark';
        }
        if (themeMeta) themeMeta.content = isDark ? '#111815' : '#f7f5eb';
      };

      syncThemeControl();
      toggle?.addEventListener('click', () => {
        root.dataset.colorTheme = root.dataset.colorTheme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('pepepow-color-theme', root.dataset.colorTheme);
        } catch {
          // The in-page toggle still works without persistent storage.
        }
        syncThemeControl();
      });
    </script>
  </body>
</html>
