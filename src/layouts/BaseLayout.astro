---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PEPEPOW',
  description = 'PEPEPOW community-powered Proof of Work.',
} = Astro.props;

const pageTitle = title === 'PEPEPOW' ? title : `${title} | PEPEPOW`;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/about/', label: 'PEPEPOW' },
  { href: '/mining/', label: 'Mining' },
  { href: '/masternode/', label: 'Masternode' },
  { href: '/wallet/', label: 'Wallets' },
  { href: '/market/', label: 'Market' },
  { href: '/announcements/', label: 'News' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111411" />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a
        class="brand"
        href="/"
        aria-label="PEPEPOW home"
        aria-current={currentPath === '/' ? 'page' : undefined}
      >
        PEPEPOW
      </a>
      <nav class="primary-nav" aria-label="Primary">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>PEPEPOW community website · Open source · Community driven</p>
    </footer>
  </body>
</html>
