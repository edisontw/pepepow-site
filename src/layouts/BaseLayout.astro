---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  theme?: 'default' | 'handdrawn';
}

const {
  title = 'PEPEPOW',
  description = 'PEPEPOW community-powered Proof of Work.',
  theme = 'default',
} = Astro.props;

const handdrawnTheme = theme === 'handdrawn';

const pageTitle = title === 'PEPEPOW' ? title : `${title} | PEPEPOW`;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.url.origin);
const primaryNavItems = [
  { href: '/network/', label: 'Network' },
  { href: '/wallet/', label: 'Wallets' },
  { href: '/mining/', label: 'Mining' },
  { href: '/masternode/', label: 'Masternode' },
  { href: '/market/', label: 'Market' },
  { href: '/announcements/', label: 'News' },
];

const utilityNavItems = [
  { href: '/about/', label: 'About' },
  { href: '/learn/', label: 'Learn' },
  { href: '/tools/', label: 'Tools' },
  { href: '/community/', label: 'Community' },
  { href: '/search/', label: 'Search' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<!doctype html>
<html lang="en" class:list={{ 'handdrawn-root': handdrawnTheme }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={handdrawnTheme ? '#f7f5eb' : '#111411'} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'handdrawn-theme': handdrawnTheme }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a
        class="brand"
        href="/"
        aria-label="PEPEPOW home"
        aria-current={currentPath === '/' ? 'page' : undefined}
      >
        PEPEPOW
      </a>
      <div class="site-navigation">
        <nav class="primary-nav" aria-label="Primary">
          {primaryNavItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <nav class="utility-nav" aria-label="Utility">
          {utilityNavItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>PEPEPOW · Open source · Community maintained</p>
    </footer>
  </body>
</html>
