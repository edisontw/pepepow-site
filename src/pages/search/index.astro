---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type SearchEntry = {
  title: string;
  href: string;
  kind: string;
  date: string;
  categories: string[];
  tags: string[];
  text: string;
};

const groups = await Promise.all([
  getCollection('pages'),
  getCollection('announcements'),
  getCollection('articles'),
]);

const rawEntries = groups.flat();

const routeFor = (entry: (typeof rawEntries)[number]) => {
  if (entry.collection === 'pages' && entry.data.slug === 'home-new') return '/';
  if (entry.collection === 'pages' && entry.data.slug === 'announcements') return '/announcements/';

  if (entry.data.legacy_url) {
    return new URL(entry.data.legacy_url).pathname;
  }

  const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
  return '/' + slug.replace(/^\/+|\/+$/g, '') + '/';
};

const kindFor = (entry: (typeof rawEntries)[number]) => {
  if (entry.collection === 'pages') return 'Current page';
  if (entry.collection === 'announcements') return 'Announcement';
  return 'Historical article';
};

const cleanBody = (body: string) =>
  body
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#|{}\[\]~-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 1800);

const searchIndex: SearchEntry[] = rawEntries
  .filter((entry) => entry.data.status !== 'archived')
  .map((entry) => ({
    title: entry.data.title,
    href: routeFor(entry),
    kind: kindFor(entry),
    date: entry.data.date.toISOString().slice(0, 10),
    categories: entry.data.categories,
    tags: entry.data.tags,
    text: [
      entry.data.description,
      entry.data.categories.join(' '),
      entry.data.tags.join(' '),
      cleanBody(String((entry as any).body ?? '')),
    ]
      .filter(Boolean)
      .join(' '),
  }))
  .sort((a, b) => b.date.localeCompare(a.date));

const serializedIndex = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Search"
  description="Search PEPEPOW current pages, announcements, and recovered historical technical articles."
  theme="handdrawn"
>
  <article class="search-page">
    <header class="search-page-header">
      <p class="eyebrow">Search</p>
      <h1>Find PEPEPOW information.</h1>
      <p class="current-page-lede">
        Search current operational pages, recovered announcements, and historical technical
        articles. Older results keep their publication context and may not describe current software
        or services.
      </p>
    </header>

    <section class="search-panel" aria-labelledby="search-title">
      <h2 id="search-title" class="visually-hidden">Site search</h2>
      <form id="site-search-form" class="site-search-form" role="search">
        <label for="site-search-input">Search terms</label>
        <div class="site-search-controls">
          <input
            id="site-search-input"
            name="q"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="wallet sync, HooHash, masternode, vote…"
          />
          <button class="button" type="submit">Search</button>
        </div>
      </form>

      <p id="search-summary" class="search-summary" aria-live="polite">
        Enter one or more terms to search {searchIndex.length} indexed records.
      </p>

      <div id="search-results" class="search-results"></div>
      <noscript>
        <p class="archive-note">
          Site search needs JavaScript in the browser. The rest of pepepow.net remains static and
          usable without it; use the main navigation or announcements archive when JavaScript is
          disabled.
        </p>
      </noscript>
    </section>

    <script id="search-index" type="application/json" set:html={serializedIndex}></script>
    <script>
      const input = document.querySelector('#site-search-input');
      const form = document.querySelector('#site-search-form');
      const results = document.querySelector('#search-results');
      const summary = document.querySelector('#search-summary');
      const dataNode = document.querySelector('#search-index');

      const index = dataNode ? JSON.parse(dataNode.textContent || '[]') : [];

      const normalize = (value) =>
        String(value || '')
          .toLocaleLowerCase()
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, ' ');

      const termsFor = (query) =>
        normalize(query)
          .split(/\s+/)
          .map((term) => term.trim())
          .filter(Boolean);

      const scoreEntry = (entry, terms) => {
        const title = normalize(entry.title);
        const categories = normalize(entry.categories.join(' '));
        const tags = normalize(entry.tags.join(' '));
        const text = normalize(entry.text);
        let score = 0;

        for (const term of terms) {
          const found =
            title.includes(term) ||
            categories.includes(term) ||
            tags.includes(term) ||
            text.includes(term);

          if (!found) return -1;
          if (title.includes(term)) score += 8;
          if (categories.includes(term)) score += 4;
          if (tags.includes(term)) score += 4;
          if (text.includes(term)) score += 1;
        }

        return score;
      };

      const renderResults = (query) => {
        if (!(input instanceof HTMLInputElement) || !results || !summary) return;

        const terms = termsFor(query);
        results.replaceChildren();

        if (terms.length === 0) {
          summary.textContent = 'Enter one or more terms to search ' + index.length + ' indexed records.';
          return;
        }

        const matches = index
          .map((entry) => ({ entry, score: scoreEntry(entry, terms) }))
          .filter((item) => item.score >= 0)
          .sort((a, b) => b.score - a.score || b.entry.date.localeCompare(a.entry.date))
          .slice(0, 40);

        summary.textContent =
          matches.length === 0
            ? 'No results for “' + query + '”.'
            : matches.length + ' result' + (matches.length === 1 ? '' : 's') + ' for “' + query + '”.';

        for (const item of matches) {
          const entry = item.entry;
          const article = document.createElement('article');
          article.className = 'search-result';

          const meta = document.createElement('p');
          meta.className = 'search-result-meta';
          meta.textContent = entry.kind + ' · ' + entry.date;

          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = entry.href;
          link.textContent = entry.title;
          heading.append(link);

          article.append(meta, heading);

          if (entry.categories.length > 0 || entry.tags.length > 0) {
            const context = document.createElement('p');
            context.className = 'search-result-context';
            context.textContent = [...entry.categories, ...entry.tags].slice(0, 6).join(' · ');
            article.append(context);
          }

          results.append(article);
        }
      };

      const applyQuery = (query, updateUrl = false) => {
        if (!(input instanceof HTMLInputElement)) return;
        input.value = query;
        renderResults(query);

        if (updateUrl) {
          const url = new URL(window.location.href);
          if (query.trim()) url.searchParams.set('q', query.trim());
          else url.searchParams.delete('q');
          window.history.replaceState({}, '', url);
        }
      };

      if (form instanceof HTMLFormElement && input instanceof HTMLInputElement) {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          applyQuery(input.value, true);
        });

        input.addEventListener('input', () => {
          if (input.value.trim().length >= 2 || input.value.trim().length === 0) {
            renderResults(input.value);
          }
        });

        const initialQuery = new URL(window.location.href).searchParams.get('q') || '';
        applyQuery(initialQuery);
      }
    </script>
  </article>
</BaseLayout>
