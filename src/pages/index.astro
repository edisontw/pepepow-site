---
import { getCollection } from 'astro:content';
import LegacyContent from '../components/LegacyContent.astro';

const pages = await getCollection('pages');
const home = pages.find((entry) => entry.data.slug === 'home-new');

if (!home) {
  throw new Error('Recovered home page was not found in the pages collection.');
}
---

<LegacyContent entry={home} />
