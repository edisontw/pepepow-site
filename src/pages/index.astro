---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">PEPEPOW</p>
    <h1>Community-powered Proof of Work.</h1>
    <p class="lede">Transparent, open source, and community driven.</p>
    <div class="actions">
      <a class="button" href="/about/">Get started</a>
      <a class="button secondary" href="/network/">Explore network</a>
    </div>
  </section>

  <section class="section">
    <h2>Migration in progress</h2>
    <p>
      pepepow.net is being rebuilt from the legacy WordPress site into a static-first Astro
      website. Historical content and important URLs are being preserved before live network
      features and additional tools are introduced.
    </p>
  </section>
</BaseLayout>
