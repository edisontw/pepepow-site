---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkPulse from '../components/NetworkPulse.astro';
import { verifiedLinks } from '../data/verified-links';
import lensData from '../data/generated/pepepow-lens.json';

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const lensItems = lensData.items.slice(0, 3);

const routeFor = (entry: (typeof announcements)[number]) => {
  if (entry.data.legacy_url) {
    return new URL(entry.data.legacy_url).pathname;
  }

  const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
  return `/${slug.replace(/^\/+|\/+$/g, '')}/`;
};

const startItems = [
  {
    href: '/wallet/',
    title: 'Wallets',
    text: 'Choose a browser, Android, or full Core wallet and start with current safety guidance.',
    icon: '/media/visual/handdrawn/icons/icon-wallet-v1.webp',
  },
  {
    href: '/mining/',
    title: 'Mining',
    text: 'Start mining HooHash V110 with current software, pool, and setup references.',
    icon: '/media/visual/handdrawn/icons/icon-mine-pickaxe-v1.webp',
  },
  {
    href: '/masternode/',
    title: 'Masternode',
    text: 'Learn the collateral tiers, setup flow, operating checks, and backup essentials.',
    icon: '/media/visual/handdrawn/icons/icon-masternode-v1.webp',
  },
  {
    href: '/market/',
    title: 'Market',
    text: 'Find current PEPEW market references and confirmed third-party venues.',
    icon: '/media/visual/handdrawn/icons/icon-market-v1.webp',
  },
  {
    href: '/learn/',
    title: 'Learn',
    text: 'Learn Proof of Work, wallets, blocks, and network metrics through practical PEPEPOW examples.',
    icon: '/media/visual/handdrawn/icons/icon-guides-book-v1.webp',
  },
];

const quickLinks = [
  ['Site Search', '/search/'],
  ['Tools', '/tools/'],
  ['Community', '/community/'],
  ['Development Roadmap', '/roadmap/'],
  ['Explorer', verifiedLinks.explorer],
  ['Core releases', verifiedLinks.coreReleases],
  ['PEPEW Light', verifiedLinks.pepewLightWallet],
  ['HTN Miner', verifiedLinks.htnMiner],
  ['Community Pool', verifiedLinks.communityPool],
  ['Lab Pool', verifiedLinks.labPool],
  ['Discord', verifiedLinks.discord],
];
---

<BaseLayout
  title="PEPEPOW"
  description="PEPEPOW is a community-powered Proof-of-Work network for PEPEW wallets, HooHash mining, masternodes, open-source tools, and transparent network data."
  theme="handdrawn"
>
  <div class="home-shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <p class="eyebrow">PEPEPOW · PEPEW</p>
        <h1 id="home-title">
          <span class="home-hero-title-line">Community-powered</span>
          <span class="home-hero-title-line">Proof of Work.</span>
        </h1>
        <p class="home-hero-lede">
          A small, open-source Proof-of-Work network built and maintained by its community. Get a
          wallet, mine PEPEW, run a masternode, or inspect the chain yourself.
        </p>
        <div class="actions">
          <a class="button" href="/network/">Explore Network</a>
          <a class="button secondary" href="/wallet/">Get a Wallet</a>
          <a class="text-action" href="/about/">About PEPEPOW →</a>
        </div>
        <div class="home-hero-lettering" aria-hidden="true">
          <img
            src="/media/visual/handdrawn/lettering/lettering-small-chain-big-community-v1.webp"
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="visually-hidden">Small Chain, Big Community</span>
      </div>

      <div class="home-hero-art" aria-hidden="true">
        <img
          class="home-hero-art-image"
          src="/media/visual/handdrawn/heroes/homepage-hero-valley-v2.webp"
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </section>

    <div class="home-pulse">
      <NetworkPulse compact />
    </div>

    <section class="home-section" aria-labelledby="start-title">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="start-title">Pick a place to start.</h2>
      </div>
      <div class="start-grid">
        {startItems.map((item) => (
          <a class="start-card" href={item.href}>
            <img class="start-card-icon" src={item.icon} alt="" loading="lazy" decoding="async" />
            <span class="card-arrow" aria-hidden="true">↗</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="latest-title">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow">PEPEPOW News</p>
          <h2 id="latest-title">Latest from PEPEPOW.</h2>
        </div>
        <a class="text-action" href="/announcements/">All announcements →</a>
      </div>

      <div class="latest-grid">
        {announcements.map((entry) => {
          const date = entry.data.date.toISOString().slice(0, 10);
          const categories = entry.data.categories.filter(
            (category) => category !== 'Announcements',
          );

          return (
            <article class="latest-card">
              <p class="card-meta">
                <time datetime={date}>{date}</time>
                {categories.length > 0 && (
                  <span> · {categories.slice(0, 2).join(' · ')}</span>
                )}
              </p>
              <h3><a href={routeFor(entry)}>{entry.data.title}</a></h3>
            </article>
          );
        })}
      </div>
      <p class="archive-context">
        Announcements keep their original publication dates and context. For up-to-date setup or
        operational guidance, use the Wallet, Mining, Masternode, Market, and Network pages.
      </p>
    </section>


    {lensItems.length > 0 && (
      <section class="home-section" aria-labelledby="lens-title">
        <div class="section-heading section-heading-row">
          <div>
            <p class="eyebrow">PEPEPOW Lens</p>
            <h2 id="lens-title">A few developments worth tracking.</h2>
          </div>
          <a class="text-action" href="/lens/">View Lens →</a>
        </div>

        <div class="lens-list lens-list--compact">
          {lensItems.map((item) => (
            <article class="lens-item">
              <h3>
                <a href={item.url}>{item.title}</a>
                <span class="lens-tag">{item.category}</span>
              </h3>
              <p class="lens-meta">
                {item.source} · <time datetime={item.published}>{item.published.slice(0, 10)}</time>
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="home-section" aria-labelledby="links-title">
      <div class="section-heading">
        <p class="eyebrow">Useful entry points</p>
        <h2 id="links-title">Project tools, services, and sources.</h2>
      </div>
      <div class="quick-links" aria-label="Useful PEPEPOW links">
        {quickLinks.map(([label, href]) => (
          <a href={href}>{label}<span aria-hidden="true"> ↗</span></a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
