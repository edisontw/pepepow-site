---
import { getCollection } from 'astro:content';
import LegacyContent from '../components/LegacyContent.astro';
import CurrentPage from '../components/CurrentPage.astro';

export async function getStaticPaths() {
  const groups = await Promise.all([
    getCollection('pages'),
    getCollection('announcements'),
    getCollection('articles'),
  ]);

  return groups
    .flat()
    .filter(
      (entry) =>
        !(
          entry.collection === 'pages' &&
          (entry.data.slug === 'announcements' || entry.data.slug === 'home-new')
        ),
    )
    .map((entry) => {
      let pathname: string;

      if (entry.collection === 'pages') {
        const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
        pathname = `/${slug.replace(/^\/+|\/+$/g, '')}/`;
      } else {
        const legacyUrl = entry.data.legacy_url;
        if (legacyUrl) {
          pathname = new URL(legacyUrl).pathname;
        } else {
          const slug = entry.data.slug || entry.id.replace(/\.mdx?$/, '');
          pathname = `/${slug.replace(/^\\/+|\\/+$/g, '')}/`;
        }
      }

      if (pathname === '/') return null;

      const legacy = pathname.replace(/^\/+|\/+$/g, '');
      if (!legacy) return null;

      return {
        params: { legacy },
        props: { entry },
      };
    })
    .filter(Boolean);
}

const { entry } = Astro.props;
---

{entry.collection === 'pages' ? <CurrentPage entry={entry} /> : <LegacyContent entry={entry} />}
