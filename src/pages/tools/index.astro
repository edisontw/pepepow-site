---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    title: 'PEPEPOW Explorer',
    text: 'Current public chain, block, network, masternode, and collected market information.',
    href: 'https://explorer.pepepow.org/',
    label: 'Open Explorer',
  },
  {
    title: 'Site search',
    text: 'Search current pages, recovered announcements, and historical technical articles without a server-side search service.',
    href: '/search/',
    label: 'Search PEPEPOW',
  },
  {
    title: 'PEPEW Light',
    text: 'Current lightweight PEPEW wallet entry point referenced by the site.',
    href: 'https://light.pepepow.net/wallet/',
    label: 'Open PEPEW Light',
  },
  {
    title: 'Core releases',
    text: 'Official PEPEPOW Core release artifacts and version history.',
    href: 'https://github.com/MattF42/PePe-core/releases',
    label: 'Open Core releases',
  },
  {
    title: 'Android releases',
    text: 'Android wallet release artifacts maintained in the current PEPEPOW Android repository.',
    href: 'https://github.com/edisontw/pepepow-android-wallet-v2/releases',
    label: 'Open Android releases',
  },
  {
    title: 'HTN Miner',
    text: 'Current miner entry point referenced by the PEPEPOW mining page.',
    href: 'https://htn.foztor.net/',
    label: 'Open HTN Miner',
  },
  {
    title: 'Community Pool',
    text: 'Community mining pool entry point referenced by current mining guidance.',
    href: 'https://community-pool.pepepow.org/',
    label: 'Open Community Pool',
  },
  {
    title: 'Lab Pool',
    text: 'PEPEPOW lab pool entry point referenced by current mining guidance.',
    href: 'https://pool.pepepow.net/',
    label: 'Open Lab Pool',
  },
  {
    title: 'Market references',
    text: 'Current PEPEW venue and market-reference page with third-party risk context.',
    href: '/market/',
    label: 'Open Market page',
  },
];

const safetyNotes = [
  'Verify release source and version before replacing wallet or node binaries.',
  'Keep wallet backups and recovery material offline from public support channels.',
  'Treat exchange, pool, miner, and wallet services as external dependencies whose status can change.',
  'Use the Network page and Explorer to distinguish local problems from network-wide conditions.',
];
---

<BaseLayout
  title="Tools"
  description="PEPEPOW Explorer, wallet, miner, pool, release, market, and search entry points in one compact directory."
  theme="handdrawn"
>
  <article class="hub-page">
    <header class="hub-page-header">
      <p class="eyebrow">Tools</p>
      <h1>Useful PEPEPOW entry points in one place.</h1>
      <p class="current-page-lede">
        This directory links to current project pages and public services. It does not proxy wallet
        RPC, store keys, or create a second blockchain collector.
      </p>
      <div class="actions">
        <a class="button" href="https://explorer.pepepow.org/">Open Explorer</a>
        <a class="button secondary" href="/search/">Search the site</a>
      </div>
    </header>

    <section class="hub-section" aria-labelledby="tools-title">
      <div class="section-heading">
        <p class="eyebrow">Directory</p>
        <h2 id="tools-title">Current tools and references.</h2>
      </div>
      <div class="hub-card-grid">
        {tools.map((item) => (
          <article class="hub-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-action" href={item.href}>{item.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="tool-safety-title">
      <div class="section-heading">
        <p class="eyebrow">Safety</p>
        <h2 id="tool-safety-title">Before using external tools.</h2>
      </div>
      <ul class="hub-safety-list">
        {safetyNotes.map((note) => <li>{note}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
