---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifiedLinks } from '../../data/verified-links';

const tools = [
  {
    title: 'PEPEPOW Explorer',
    text: 'Inspect blocks, addresses, masternodes, network activity, and collected market data.',
    href: verifiedLinks.explorer,
    label: 'Open Explorer',
  },
  {
    title: 'Site search',
    text: 'Search current pages, announcements, and historical technical material from the site’s static index.',
    href: '/search/',
    label: 'Search PEPEPOW',
  },
  {
    title: 'PEPEW Light',
    text: 'Open the lightweight, non-custodial PEPEW wallet used for browser-based access.',
    href: verifiedLinks.pepewLightWallet,
    label: 'Open PEPEW Light',
  },
  {
    title: 'Core releases',
    text: 'Download PEPEPOW Core releases and review version history from the source repository.',
    href: verifiedLinks.coreReleases,
    label: 'Open Core releases',
  },
  {
    title: 'Android releases',
    text: 'Download Android wallet releases from the current PEPEPOW Android repository.',
    href: verifiedLinks.androidWalletReleases,
    label: 'Open Android releases',
  },
  {
    title: 'HTN Miner',
    text: 'Download current HTN Miner builds used by the PEPEPOW mining guide.',
    href: verifiedLinks.htnMiner,
    label: 'Open HTN Miner',
  },
  {
    title: 'Community Pool',
    text: 'Open the community mining pool and check its current connection details.',
    href: verifiedLinks.communityPool,
    label: 'Open Community Pool',
  },
  {
    title: 'Lab Pool',
    text: 'Open the PEPEPOW lab pool for development and testing use.',
    href: verifiedLinks.labPool,
    label: 'Open Lab Pool',
  },
  {
    title: 'Market references',
    text: 'Review current PEPEW market references, confirmed venues, and third-party risk notes.',
    href: '/market/',
    label: 'Open Market page',
  },
];

const safetyNotes = [
  'Verify release source and version before replacing wallet or node binaries.',
  'Keep wallet backups and recovery material offline from public support channels.',
  'Treat exchange, pool, miner, and wallet services as external dependencies whose status can change.',
  'Use the Network page and Explorer to distinguish local problems from network-wide conditions.',
];
---

<BaseLayout
  title="Tools"
  description="A compact directory of PEPEPOW Explorer, wallet, mining, release, market, community, and search resources."
  theme="handdrawn"
>
  <article class="hub-page">
    <header class="hub-page-header">
      <p class="eyebrow">Tools</p>
      <h1>PEPEPOW tools and services in one place.</h1>
      <p class="current-page-lede">
        Use this directory to reach current project tools, downloads, and public services. The site
        does not store keys, proxy wallet RPC, or duplicate the blockchain monitor.
      </p>
      <div class="actions">
        <a class="button" href={verifiedLinks.explorer}>Open Explorer</a>
        <a class="button secondary" href="/search/">Search the site</a>
      </div>
    </header>

    <section class="hub-section" aria-labelledby="tools-title">
      <div class="section-heading">
        <p class="eyebrow">Directory</p>
        <h2 id="tools-title">Open the tool you need.</h2>
      </div>
      <div class="hub-card-grid">
        {tools.map((item) => (
          <article class="hub-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-action" href={item.href}>{item.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="tool-safety-title">
      <div class="section-heading">
        <p class="eyebrow">Safety</p>
        <h2 id="tool-safety-title">A few checks before you connect.</h2>
      </div>
      <ul class="hub-safety-list">
        {safetyNotes.map((note) => <li>{note}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
