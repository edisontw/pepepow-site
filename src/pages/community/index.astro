---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IllustratedPageHeader from '../../components/IllustratedPageHeader.astro';
import { verifiedLinks } from '../../data/verified-links';

const communityLinks = [
  {
    title: 'Discord',
    text: 'Join the main public PEPEPOW discussion channel for community conversation and support.',
    href: verifiedLinks.discord,
    label: 'Join Discord',
  },
  {
    title: 'Twitter / X',
    text: 'Follow PEPEPOW community updates and public project activity.',
    href: verifiedLinks.twitter,
    label: 'Follow PEPEW Community',
  },
  {
    title: 'Telegram announcements',
    text: 'Receive PEPEPOW announcements and important project updates on Telegram.',
    href: verifiedLinks.telegramAnnouncements,
    label: 'Open announcement channel',
  },
  {
    title: 'Telegram chat · EN',
    text: 'Join the English-language PEPEPOW community chat for discussion and support.',
    href: verifiedLinks.telegramChatEn,
    label: 'Join Telegram chat',
  },
  {
    title: 'Website source',
    text: 'Review or contribute to pepepow.net. The public GitHub main branch is the website’s source of truth.',
    href: verifiedLinks.websiteRepository,
    label: 'Open site repository',
  },
  {
    title: 'PEPEPOW Core',
    text: 'Inspect PEPEPOW Core source code, releases, issues, and technical history.',
    href: verifiedLinks.coreRepository,
    label: 'Open Core repository',
  },
  {
    title: 'Announcements',
    text: 'Browse releases, network changes, community notices, votes, and other dated project records.',
    href: '/announcements/',
    label: 'Browse announcements',
  },
  {
    title: 'Explorer',
    text: 'Check current chain and network data before relying on an older announcement or technical guide.',
    href: verifiedLinks.explorer,
    label: 'Open Explorer',
  },
  {
    title: 'Community infrastructure',
    text: 'Find current community and lab pool links together with the latest mining guidance.',
    href: '/mining/',
    label: 'Open mining resources',
  },
];

const participation = [
  ['Verify before repeating', 'Prefer current source code, releases, Explorer data, and dated announcements over screenshots or copied instructions.'],
  ['Protect keys and recovery material', 'Never post private keys, wallet.dat files, seed phrases, masternode keys, or RPC credentials in public support channels.'],
  ['Keep historical context', 'Older announcements are useful records, but versions, exchanges, pools, peer addresses, and recovery steps can become obsolete.'],
  ['Contribute reproducibly', 'Submit website corrections through the public repository so changes can be reviewed, traced, and rebuilt from source.'],
];
---

<BaseLayout
  title="Community"
  description="PEPEPOW community channels, public source repositories, contribution paths, announcements, and practical safety guidance."
  theme="handdrawn"
>
  <article class="hub-page">
    <IllustratedPageHeader
      eyebrow="Community"
      title="Find the people, code, and public record."
      intro="PEPEPOW is maintained through open repositories, public network services, dated announcements, and community discussion. When details matter, follow the source and check that it is current."
      image="/media/visual/handdrawn/headers/header-community-v1.webp"
      actions={[
        { label: 'Join Discord', href: verifiedLinks.discord, primary: true },
        { label: 'Website source', href: verifiedLinks.websiteRepository },
        { label: 'Core source', href: verifiedLinks.coreRepository },
      ]}
    />

    <section class="hub-section" aria-labelledby="community-links-title">
      <div class="section-heading">
        <p class="eyebrow">Entry points</p>
        <h2 id="community-links-title">Choose the right community entry point.</h2>
      </div>
      <div class="hub-card-grid">
        {communityLinks.map((item) => (
          <article class="hub-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-action" href={item.href}>{item.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="participation-title">
      <div class="section-heading">
        <p class="eyebrow">Participation</p>
        <h2 id="participation-title">Keep participation open, traceable, and safe.</h2>
      </div>
      <dl class="hub-definition-list">
        {participation.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="hub-section" aria-labelledby="history-title">
      <div class="section-heading">
        <p class="eyebrow">History and governance</p>
        <h2 id="history-title">The archive records what happened; current pages show what applies now.</h2>
      </div>
      <p class="hub-copy">
        Community votes, funding discussions, service changes, releases, and incident updates are
        preserved in the announcement archive. Use those dated records to understand decisions and
        history, then confirm today’s operational state on the relevant current page, repository, or
        Explorer.
      </p>
      <div class="actions">
        <a class="button secondary" href="/search/?q=vote">Search governance history</a>
        <a class="button secondary" href="/announcements/">Announcement archive</a>
      </div>
    </section>
  </article>
</BaseLayout>
