---
import BaseLayout from '../../layouts/BaseLayout.astro';

const learningPaths = [
  {
    title: 'Proof of Work and mining',
    text: 'Start with PEPEPOW mining, HooHash V110, pools, miners, hashrate, and why mining secures the chain.',
    href: '/mining/',
  },
  {
    title: 'Blocks and network health',
    text: 'Learn how block height, block freshness, block time, hashrate, and masternode state help describe network activity.',
    href: '/network/',
  },
  {
    title: 'Wallets and self-custody',
    text: 'Understand wallet choices, backups, recovery risk, software updates, and why private recovery material must stay private.',
    href: '/wallet/',
  },
  {
    title: 'Masternodes',
    text: 'Review PEPEPOW masternode requirements, collateral context, operation, rewards, and maintenance references.',
    href: '/masternode/',
  },
  {
    title: 'Markets and third-party risk',
    text: 'Use current market references while treating exchanges and other third-party services as changeable external dependencies.',
    href: '/market/',
  },
  {
    title: 'Project history',
    text: 'Read dated announcements and technical articles to see how PEPEPOW software, mining, services, and governance evolved.',
    href: '/announcements/',
  },
];

const principles = [
  ['Check the date', 'A technically correct 2024 guide may be unsafe or obsolete in 2026.'],
  ['Prefer primary sources', 'Use source repositories, release pages, the Explorer, and current site guidance before third-party summaries.'],
  ['Separate keys from public support', 'Private keys, seed phrases, wallet files, RPC credentials, and masternode secrets should never be shared for troubleshooting.'],
  ['Distinguish live data from documentation', 'Changing values such as height, hashrate, price, and masternode count belong to live data sources rather than static prose.'],
];
---

<BaseLayout
  title="Learn"
  description="Learn Proof of Work, wallets, blocks, masternodes, mining, self-custody, and PEPEPOW history through current practical references."
>
  <article class="hub-page">
    <header class="hub-page-header">
      <p class="eyebrow">Learn</p>
      <h1>Learn crypto concepts through PEPEPOW.</h1>
      <p class="current-page-lede">
        Use practical PEPEPOW examples to understand Proof of Work, wallets, network metrics,
        masternodes, third-party services, and source verification without turning historical
        material into current instructions.
      </p>
      <div class="actions">
        <a class="button" href="/network/">Start with the network</a>
        <a class="button secondary" href="/search/">Search the archive</a>
      </div>
    </header>

    <section class="hub-section" aria-labelledby="paths-title">
      <div class="section-heading">
        <p class="eyebrow">Learning paths</p>
        <h2 id="paths-title">Choose a practical starting point.</h2>
      </div>
      <div class="hub-card-grid">
        {learningPaths.map((item) => (
          <a class="hub-card hub-card-link" href={item.href}>
            <span class="card-arrow" aria-hidden="true">↗</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="reading-title">
      <div class="section-heading">
        <p class="eyebrow">How to read technical crypto information</p>
        <h2 id="reading-title">Four habits prevent many mistakes.</h2>
      </div>
      <dl class="hub-definition-list">
        {principles.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="hub-section" aria-labelledby="archive-learning-title">
      <div class="section-heading">
        <p class="eyebrow">Historical material</p>
        <h2 id="archive-learning-title">Useful for understanding change.</h2>
      </div>
      <p class="hub-copy">
        The recovered PEPEPOW archive includes older wallet, mining, masternode, incident, and
        governance material. Historical technical articles are visibly marked because commands,
        versions, block heights, peer addresses, and services can become obsolete. Use them to
        understand what happened, then return to current pages for operational steps.
      </p>
    </section>
  </article>
</BaseLayout>
