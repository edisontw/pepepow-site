---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IllustratedPageHeader from '../../components/IllustratedPageHeader.astro';

const learningPaths = [
  {
    title: 'Proof of Work and mining',
    text: 'See how HooHash V110, miners, pools, and hashrate work together to secure the PEPEPOW chain.',
    href: '/mining/',
  },
  {
    title: 'Blocks and network health',
    text: 'Learn what block height, block age, block time, hashrate, and masternode state can tell you about network activity.',
    href: '/network/',
  },
  {
    title: 'Wallets and self-custody',
    text: 'Compare wallet choices and learn the basics of backups, recovery, updates, and protecting private recovery material.',
    href: '/wallet/',
  },
  {
    title: 'Masternodes',
    text: 'Understand PEPEPOW collateral tiers, setup, operation, reward selection, maintenance, and common safety checks.',
    href: '/masternode/',
  },
  {
    title: 'Markets and third-party risk',
    text: 'Learn how to verify market access while treating exchanges and other third-party services as changeable external dependencies.',
    href: '/market/',
  },
  {
    title: 'Project history',
    text: 'Follow dated announcements and technical articles to see how PEPEPOW software, mining, services, and community decisions changed over time.',
    href: '/announcements/',
  },
];

const principles = [
  ['Check the date', 'A guide can be historically correct and still be unsafe or obsolete for today’s software.'],
  ['Prefer primary sources', 'Check source repositories, release pages, the Explorer, and current site guidance before relying on copied instructions.'],
  ['Keep secrets out of support channels', 'Never share private keys, seed phrases, wallet files, RPC credentials, or masternode secrets for troubleshooting.'],
  ['Separate live data from documentation', 'Values such as block height, hashrate, price, and masternode count change continuously and should be checked from live sources.'],
];
---

<BaseLayout
  title="Learn"
  description="Learn Proof of Work, wallets, mining, blocks, masternodes, self-custody, and network verification through practical PEPEPOW examples."
  theme="handdrawn"
>
  <article class="hub-page">
    <IllustratedPageHeader
      eyebrow="Learn"
      title="Learn how PEPEPOW works."
      intro="Use practical PEPEPOW examples to understand Proof of Work, wallets, network metrics, masternodes, third-party services, and how to verify information before acting on it."
      image="/media/visual/handdrawn/headers/header-guides-v1.webp"
      actions={[
        { label: 'Start with the network', href: '/network/', primary: true },
        { label: 'Search the archive', href: '/search/' },
      ]}
    />

    <section class="hub-section" aria-labelledby="paths-title">
      <div class="section-heading">
        <p class="eyebrow">Learning paths</p>
        <h2 id="paths-title">Choose what you want to understand.</h2>
      </div>
      <div class="hub-card-grid">
        {learningPaths.map((item) => (
          <a class="hub-card hub-card-link" href={item.href}>
            <span class="card-arrow" aria-hidden="true">↗</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="reading-title">
      <div class="section-heading">
        <p class="eyebrow">Reading technical information</p>
        <h2 id="reading-title">Four habits make technical information safer to use.</h2>
      </div>
      <dl class="hub-definition-list">
        {principles.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="hub-section" aria-labelledby="archive-learning-title">
      <div class="section-heading">
        <p class="eyebrow">Historical material</p>
        <h2 id="archive-learning-title">History explains how the project changed.</h2>
      </div>
      <p class="hub-copy">
        The PEPEPOW archive preserves older wallet, mining, masternode, incident, and governance
        material. Commands, versions, peer addresses, and services can become obsolete, so historical
        technical pages are clearly marked. Use them to understand what changed, then return to the
        current pages before taking operational action.
      </p>
    </section>
  </article>
</BaseLayout>
