---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkPulse from '../../components/NetworkPulse.astro';

const metricGuides = [
  ['Block height', 'The latest block number seen by the cached network monitor. A moving height is one basic sign that the chain is progressing.'],
  ['Last block age', 'How long it has been since the latest observed block. This helps distinguish a slow chain from a stale website snapshot.'],
  ['Block time', 'PEPEPOW targets an average block interval; individual blocks can arrive sooner or later. The pulse shows a recent rolling average.'],
  ['Hashrate', 'An estimate of the mining work securing the network. It can vary as miners enter, leave, or switch hardware.'],
  ['Masternodes', 'Network service nodes that participate in PEPEPOW masternode functions and reward selection. Counts and states change over time.'],
  ['Freshness', 'The monitor reports snapshot age separately from last-block age so a stale monitor is not confused with a slow or stalled chain.'],
];

const entryPoints = [
  {
    title: 'Explorer',
    text: 'Use the PEPEPOW Explorer for current chain, block, network, masternode, and collected market information.',
    href: 'https://explorer.pepepow.org/',
    label: 'Open Explorer',
  },
  {
    title: 'Mining',
    text: 'Current PEPEPOW mining uses HooHash V110. Use the mining page for current miner and pool entry points.',
    href: '/mining/',
    label: 'Mining guide',
  },
  {
    title: 'Masternodes',
    text: 'Use the masternode page for current collateral tiers, setup guidance, release references, and operational checks.',
    href: '/masternode/',
    label: 'Masternode guide',
  },
];
---

<BaseLayout
  title="Network"
  description="PEPEPOW Network Pulse, live cached network visibility, Explorer entry points, and explanations of common network metrics."
>
  <article class="network-page">
    <header class="network-page-header">
      <p class="eyebrow">Network</p>
      <h1>See what the PEPEPOW network is doing.</h1>
      <p class="current-page-lede">
        Network Pulse reads a small cached public summary from the existing PEPEPOW monitor. The
        browser never connects to wallet/node RPC, and this website does not run a second blockchain
        collector. If the summary is unavailable or stale, use the Explorer for direct inspection.
      </p>
      <div class="actions">
        <a class="button" href="https://explorer.pepepow.org/">Open Live Explorer</a>
        <a class="button secondary" href="https://explorer.pepepow.org/network">Network Details</a>
      </div>
    </header>

    <NetworkPulse />

    <section class="network-page-section" aria-labelledby="entry-title">
      <div class="section-heading">
        <p class="eyebrow">Entry points</p>
        <h2 id="entry-title">Use the right source for the task.</h2>
      </div>
      <div class="network-entry-grid">
        {entryPoints.map((item) => (
          <article class="network-entry-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-action" href={item.href}>{item.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="network-page-section" aria-labelledby="metrics-title">
      <div class="section-heading">
        <p class="eyebrow">Reading the network</p>
        <h2 id="metrics-title">What the common metrics mean.</h2>
      </div>
      <dl class="metric-guide-list">
        {metricGuides.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="network-page-section" aria-labelledby="boundary-title">
      <div class="section-heading">
        <p class="eyebrow">Data boundary</p>
        <h2 id="boundary-title">Cached summary only.</h2>
      </div>
      <p class="network-copy">
        The public Network Pulse endpoint is an allowlisted slice of the existing monitor snapshot.
        It exposes only the small set of chain, masternode, service-count, and freshness fields used
        above. Peer details, block hashes, alerts, masternode records and versions, RPC diagnostics,
        credentials, and private node data are not part of the website payload. Collection remains
        centralized in the existing monitor.
      </p>
    </section>
  </article>
</BaseLayout>
