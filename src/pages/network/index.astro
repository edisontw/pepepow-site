---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkPulse from '../../components/NetworkPulse.astro';
import IllustratedPageHeader from '../../components/IllustratedPageHeader.astro';
import { verifiedLinks } from '../../data/verified-links';

const metricGuides = [
  ['Block height', 'The latest block number reported by the current data source. A steadily advancing height is one basic sign that the chain is moving.'],
  ['Last block age', 'How long it has been since the latest observed block. Read it together with data freshness so a slow chain is not confused with a stale snapshot.'],
  ['Block time', 'Individual blocks can arrive sooner or later than the target interval. Network Pulse shows a recent rolling average rather than a promise for the next block.'],
  ['Hashrate', 'An estimate of the mining work securing the network. It changes as miners join, leave, or move hardware between networks.'],
  ['Masternodes', 'Service nodes that participate in PEPEPOW masternode functions and reward selection. Counts and states can change throughout the day.'],
  ['Freshness', 'Snapshot age is shown separately from last-block age so delayed monitoring is not mistaken for a slow or stalled chain.'],
];

const entryPoints = [
  {
    title: 'Explorer',
    text: 'Inspect blocks, addresses, masternodes, network activity, and collected market data in the public Explorer.',
    href: verifiedLinks.explorer,
    label: 'Open Explorer',
  },
  {
    title: 'Mining',
    text: 'PEPEPOW currently mines with HooHash V110. Use the Mining page for current software, pool links, and setup guidance.',
    href: '/mining/',
    label: 'Mining guide',
  },
  {
    title: 'Masternodes',
    text: 'Use the Masternode page for collateral tiers, setup steps, release references, maintenance, and status checks.',
    href: '/masternode/',
    label: 'Masternode guide',
  },
];
---

<BaseLayout
  title="Network"
  description="Track PEPEPOW block height, hashrate, masternodes, block timing, and data freshness through cached public network sources."
  theme="handdrawn"
>
  <article class="network-page">
    <IllustratedPageHeader
      eyebrow="Network"
      title="Follow the PEPEPOW network in real time."
      intro="Network Pulse combines lightweight cached data from existing PEPEPOW services to show current chain activity without exposing wallet or node RPC. If a reading is delayed or unavailable, open the Explorer for a closer look."
      image="/media/visual/handdrawn/headers/header-network-pulse-v1.webp"
      actions={[
        { label: 'Open Live Explorer', href: verifiedLinks.explorer, primary: true },
        { label: 'Network Details', href: verifiedLinks.explorerNetwork },
      ]}
    />

    <NetworkPulse />

    <section class="network-page-section" aria-labelledby="entry-title">
      <div class="section-heading">
        <p class="eyebrow">Entry points</p>
        <h2 id="entry-title">Go deeper when you need more detail.</h2>
      </div>
      <div class="network-entry-grid">
        {entryPoints.map((item) => (
          <article class="network-entry-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-action" href={item.href}>{item.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="network-page-section" aria-labelledby="metrics-title">
      <div class="section-heading">
        <p class="eyebrow">Reading the network</p>
        <h2 id="metrics-title">How to read the numbers.</h2>
      </div>
      <dl class="metric-guide-list">
        {metricGuides.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="network-page-section" aria-labelledby="boundary-title">
      <div class="section-heading">
        <p class="eyebrow">Data boundary</p>
        <h2 id="boundary-title">Public data, deliberately limited.</h2>
      </div>
      <p class="network-copy">
        Network Pulse exposes only the small set of chain, masternode, service, and freshness
        fields needed for this page. It does not publish credentials, private node details, RPC
        diagnostics, peer inventories, or full masternode records. Collection stays in the existing
        monitor rather than being duplicated by the website.
      </p>
    </section>
  </article>
</BaseLayout>
