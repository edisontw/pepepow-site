---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Publisher"
  description="Private PEPEPOW announcement publishing interface."
  theme="handdrawn"
  noindex
>
  <article class="publisher-page">
    <header class="publisher-header">
      <p class="eyebrow">PEPEPOW Publisher</p>
      <h1>Publish an announcement.</h1>
      <p class="publisher-lede">
        Sign in through GitHub, write the announcement here, and publish it to the PEPEPOW website
        repository. GitHub credentials are entered only on github.com.
      </p>
    </header>

    <section class="publisher-auth" aria-labelledby="publisher-auth-title">
      <div>
        <h2 id="publisher-auth-title">Account</h2>
        <p id="publisher-auth-status">Checking sign-in status…</p>
      </div>
      <div class="publisher-auth-actions">
        <a id="publisher-login" class="button" href="/admin-api?action=login" hidden>Sign in with GitHub</a>
        <button id="publisher-logout" class="button secondary" type="button" hidden>Sign out</button>
      </div>
    </section>

    <section id="publisher-editor" class="publisher-editor" hidden aria-labelledby="publisher-editor-title">
      <div class="publisher-editor-heading">
        <div>
          <p class="eyebrow">New announcement</p>
          <h2 id="publisher-editor-title">Write once, publish to GitHub.</h2>
        </div>
        <p class="publisher-draft-note">Draft text is saved only in this browser until publication.</p>
      </div>

      <form id="publisher-form">
        <label>
          <span>Title</span>
          <input id="announcement-title" name="title" type="text" maxlength="180" required />
        </label>

        <label>
          <span>Summary</span>
          <textarea
            id="announcement-description"
            name="description"
            rows="3"
            maxlength="300"
            placeholder="One or two sentences for search and page metadata."
          ></textarea>
        </label>

        <div class="publisher-two-column">
          <label>
            <span>Publish date and time</span>
            <input id="announcement-date" name="date" type="datetime-local" required />
          </label>

          <label>
            <span>Slug <small>(optional)</small></span>
            <input
              id="announcement-slug"
              name="slug"
              type="text"
              maxlength="80"
              pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
              placeholder="generated-from-title"
            />
          </label>
        </div>

        <fieldset>
          <legend>Categories</legend>
          <div class="publisher-check-grid">
            {['Update', 'Wallet', 'Mining', 'Masternode', 'Network', 'Market', 'Community', 'Campaigns'].map((item) => (
              <label class="publisher-check">
                <input type="checkbox" name="categories" value={item} />
                <span>{item}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label>
          <span>Tags <small>(comma separated)</small></span>
          <input id="announcement-tags" name="tags" type="text" maxlength="300" placeholder="release, hoohash, wallet" />
        </label>

        <div class="publisher-compose">
          <div class="publisher-compose-header">
            <div>
              <span class="publisher-field-label">Announcement</span>
              <small>Use the toolbar for common formatting, or edit Markdown directly.</small>
            </div>
            <div class="publisher-view-switch" role="group" aria-label="Editor view">
              <button class="publisher-view-button is-active" type="button" data-view="write" aria-pressed="true">Write</button>
              <button class="publisher-view-button" type="button" data-view="split" aria-pressed="false">Split</button>
              <button class="publisher-view-button" type="button" data-view="preview" aria-pressed="false">Preview</button>
            </div>
          </div>

          <div class="publisher-toolbar" role="toolbar" aria-label="Markdown formatting">
            <button type="button" data-format="h2" title="Heading">H2</button>
            <button type="button" data-format="bold" title="Bold"><strong>B</strong></button>
            <button type="button" data-format="italic" title="Italic"><em>I</em></button>
            <button type="button" data-format="link" title="Link">Link</button>
            <button type="button" data-format="image" title="Image">Image</button>
            <span class="publisher-toolbar-divider" aria-hidden="true"></span>
            <button type="button" data-format="bullets" title="Bulleted list">• List</button>
            <button type="button" data-format="numbers" title="Numbered list">1. List</button>
            <button type="button" data-format="quote" title="Quote">Quote</button>
            <button type="button" data-format="code" title="Inline code">&lt;/&gt;</button>
            <button type="button" data-format="codeblock" title="Code block">Code block</button>
          </div>

          <div id="publisher-compose-panels" class="publisher-compose-panels" data-view="write">
            <div class="publisher-write-panel">
              <label class="publisher-visually-hidden" for="announcement-body">Announcement Markdown</label>
              <textarea
                id="announcement-body"
                name="body"
                rows="22"
                maxlength="100000"
                required
                spellcheck="true"
                placeholder="Write your announcement. The toolbar inserts Markdown for you."
              ></textarea>
            </div>

            <article id="publisher-live-preview" class="publisher-live-preview" aria-label="Announcement preview">
              <header class="publisher-live-preview-header">
                <p class="eyebrow">Preview</p>
                <h1 id="publisher-live-title">Untitled announcement</h1>
                <p id="publisher-live-meta" class="publisher-live-meta"></p>
                <p id="publisher-live-description" class="publisher-live-description"></p>
              </header>
              <div id="publisher-live-body" class="publisher-live-body">
                <p class="publisher-preview-empty">Start writing to see the rendered preview.</p>
              </div>
            </article>
          </div>
        </div>

        <label class="publisher-check publisher-featured">
          <input id="announcement-featured" name="featured" type="checkbox" />
          <span>Feature this announcement</span>
        </label>

        <div class="publisher-actions">
          <button id="publisher-source-button" class="button secondary" type="button">View Markdown source</button>
          <button id="publisher-publish-button" class="button" type="submit">Publish</button>
        </div>

        <p id="publisher-result" class="publisher-result" role="status" aria-live="polite"></p>
      </form>

      <details id="publisher-preview" class="publisher-preview">
        <summary>Generated Markdown preview</summary>
        <pre><code id="publisher-preview-code"></code></pre>
      </details>
    </section>

    <aside class="publisher-security">
      <strong>Security boundary</strong>
      <p>
        GitHub handles account authentication and 2FA. The publisher API accepts only allowlisted
        GitHub users and creates files under <code>src/content/announcements/</code>. No GitHub
        password is sent to pepepow.net.
      </p>
    </aside>
  </article>

  <script>
    const API_ROOT = '/admin-api';
    const DRAFT_KEY = 'pepepow-announcement-draft-v1';

    const authStatus = document.querySelector('#publisher-auth-status');
    const loginLink = document.querySelector('#publisher-login');
    const logoutButton = document.querySelector('#publisher-logout');
    const editor = document.querySelector('#publisher-editor');
    const form = document.querySelector('#publisher-form');
    const result = document.querySelector('#publisher-result');
    const sourceButton = document.querySelector('#publisher-source-button');
    const preview = document.querySelector('#publisher-preview');
    const previewCode = document.querySelector('#publisher-preview-code');
    const composePanels = document.querySelector('#publisher-compose-panels');
    const livePreview = document.querySelector('#publisher-live-preview');
    const liveTitle = document.querySelector('#publisher-live-title');
    const liveMeta = document.querySelector('#publisher-live-meta');
    const liveDescription = document.querySelector('#publisher-live-description');
    const liveBody = document.querySelector('#publisher-live-body');
    const viewButtons = Array.from(document.querySelectorAll('.publisher-view-button'));
    const formatButtons = Array.from(document.querySelectorAll('[data-format]'));

    const titleInput = document.querySelector('#announcement-title');
    const descriptionInput = document.querySelector('#announcement-description');
    const dateInput = document.querySelector('#announcement-date');
    const slugInput = document.querySelector('#announcement-slug');
    const tagsInput = document.querySelector('#announcement-tags');
    const bodyInput = document.querySelector('#announcement-body');
    const featuredInput = document.querySelector('#announcement-featured');

    const requiredElements = [
      authStatus, loginLink, logoutButton, editor, form, result, sourceButton, preview,
      previewCode, composePanels, livePreview, liveTitle, liveMeta, liveDescription, liveBody,
      titleInput, descriptionInput, dateInput, slugInput, tagsInput, bodyInput, featuredInput,
    ];

    const ready = requiredElements.every(Boolean);

    const localDateTimeValue = (date = new Date()) => {
      const shifted = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
      return shifted.toISOString().slice(0, 16);
    };

    const slugify = (value) =>
      String(value || '')
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);

    const selectedCategories = () =>
      Array.from(document.querySelectorAll('input[name="categories"]:checked'))
        .map((input) => input.value);

    const getDraft = () => ({
      title: titleInput.value,
      description: descriptionInput.value,
      date: dateInput.value,
      slug: slugInput.value,
      categories: selectedCategories(),
      tags: tagsInput.value,
      body: bodyInput.value,
      featured: featuredInput.checked,
    });

    const saveDraft = () => {
      try {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(getDraft()));
      } catch {}
    };

    const restoreDraft = () => {
      let draft;
      try {
        draft = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null');
      } catch {
        draft = null;
      }

      if (!draft || typeof draft !== 'object') {
        dateInput.value = localDateTimeValue();
        return;
      }

      titleInput.value = draft.title || '';
      descriptionInput.value = draft.description || '';
      dateInput.value = draft.date || localDateTimeValue();
      slugInput.value = draft.slug || '';
      tagsInput.value = draft.tags || '';
      bodyInput.value = draft.body || '';
      featuredInput.checked = Boolean(draft.featured);

      const wanted = new Set(Array.isArray(draft.categories) ? draft.categories : []);
      for (const checkbox of document.querySelectorAll('input[name="categories"]')) {
        checkbox.checked = wanted.has(checkbox.value);
      }
    };

    const payloadForPublish = () => {
      const localDate = dateInput.value || localDateTimeValue();
      const parsed = new Date(localDate);
      const tags = tagsInput.value
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean);

      return {
        title: titleInput.value.trim(),
        description: descriptionInput.value.trim(),
        date: parsed.toISOString(),
        date_key: localDate.slice(0, 10),
        slug: slugInput.value.trim(),
        categories: selectedCategories(),
        tags,
        featured: featuredInput.checked,
        body: bodyInput.value.trim(),
      };
    };

    const yamlString = (value) => JSON.stringify(String(value || ''));
    const yamlArray = (values) => JSON.stringify(values || []);

    const generatedMarkdown = () => {
      const payload = payloadForPublish();
      const slug = payload.slug || slugify(payload.title) || 'announcement';
      return [
        '---',
        `title: ${yamlString(payload.title)}`,
        `description: ${yamlString(payload.description)}`,
        `date: ${yamlString(payload.date)}`,
        `slug: ${yamlString(slug)}`,
        `categories: ${yamlArray(['Announcements', ...payload.categories])}`,
        `tags: ${yamlArray(payload.tags)}`,
        'status: "published"',
        `featured: ${payload.featured ? 'true' : 'false'}`,
        'migration_review: false',
        '---',
        '',
        payload.body,
        '',
      ].join('\n');
    };

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const safeUrl = (value, image = false) => {
      const url = String(value || '').trim();
      if (!url) return '';
      if (/^(https?:\/\/|\/|\.\/|\.\.\/|#)/i.test(url)) return url;
      if (!image && /^mailto:/i.test(url)) return url;
      return '';
    };

    const renderInlineMarkdown = (value) => {
      const codeSpans = [];
      let text = String(value || '').replace(/`([^`\n]+)`/g, (_, code) => {
        const key = `%%CODE${codeSpans.length}%%`;
        codeSpans.push(`<code>${escapeHtml(code)}</code>`);
        return key;
      });

      text = escapeHtml(text);

      text = text.replace(/!\[([^\]]*)\]\(([^\s)]+)(?:\s+"([^"]*)")?\)/g, (_, alt, rawUrl, title) => {
        const url = safeUrl(rawUrl, true);
        if (!url) return escapeHtml(alt);
        const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
        return `<img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}"${titleAttr} loading="lazy" />`;
      });

      text = text.replace(/\[([^\]]+)\]\(([^\s)]+)(?:\s+"([^"]*)")?\)/g, (_, label, rawUrl, title) => {
        const url = safeUrl(rawUrl);
        if (!url) return label;
        const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
        return `<a href="${escapeHtml(url)}"${titleAttr} rel="noopener noreferrer">${label}</a>`;
      });

      text = text
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/__([^_]+)__/g, '<strong>$1</strong>')
        .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>')
        .replace(/(^|[^_])_([^_\n]+)_/g, '$1<em>$2</em>')
        .replace(/~~([^~]+)~~/g, '<del>$1</del>');

      codeSpans.forEach((html, index) => {
        text = text.replace(`%%CODE${index}%%`, html);
      });

      return text;
    };

    const renderMarkdown = (source) => {
      const lines = String(source || '').replace(/\r\n?/g, '\n').split('\n');
      const html = [];
      let paragraph = [];
      let listType = '';
      let listItems = [];
      let inCode = false;
      let codeLang = '';
      let codeLines = [];

      const flushParagraph = () => {
        if (!paragraph.length) return;
        html.push(`<p>${renderInlineMarkdown(paragraph.join(' '))}</p>`);
        paragraph = [];
      };

      const flushList = () => {
        if (!listItems.length || !listType) return;
        html.push(`<${listType}>${listItems.map((item) => `<li>${renderInlineMarkdown(item)}</li>`).join('')}</${listType}>`);
        listItems = [];
        listType = '';
      };

      const flushCode = () => {
        const languageClass = /^[a-z0-9_-]+$/i.test(codeLang) && codeLang
          ? ` class="language-${escapeHtml(codeLang)}"`
          : '';
        html.push(`<pre><code${languageClass}>${escapeHtml(codeLines.join('\n'))}</code></pre>`);
        codeLines = [];
        codeLang = '';
      };

      for (const line of lines) {
        const fence = line.match(/^\s*```\s*([^\s]*)\s*$/);
        if (fence) {
          if (inCode) {
            flushCode();
            inCode = false;
          } else {
            flushParagraph();
            flushList();
            inCode = true;
            codeLang = fence[1] || '';
          }
          continue;
        }

        if (inCode) {
          codeLines.push(line);
          continue;
        }

        if (!line.trim()) {
          flushParagraph();
          flushList();
          continue;
        }

        const heading = line.match(/^(#{1,6})\s+(.+)$/);
        if (heading) {
          flushParagraph();
          flushList();
          const level = heading[1].length;
          html.push(`<h${level}>${renderInlineMarkdown(heading[2])}</h${level}>`);
          continue;
        }

        if (/^\s*(?:---+|___+|\*\*\*+)\s*$/.test(line)) {
          flushParagraph();
          flushList();
          html.push('<hr />');
          continue;
        }

        const quote = line.match(/^>\s?(.*)$/);
        if (quote) {
          flushParagraph();
          flushList();
          html.push(`<blockquote><p>${renderInlineMarkdown(quote[1])}</p></blockquote>`);
          continue;
        }

        const unordered = line.match(/^\s*[-+*]\s+(.+)$/);
        if (unordered) {
          flushParagraph();
          if (listType && listType !== 'ul') flushList();
          listType = 'ul';
          listItems.push(unordered[1]);
          continue;
        }

        const ordered = line.match(/^\s*\d+[.)]\s+(.+)$/);
        if (ordered) {
          flushParagraph();
          if (listType && listType !== 'ol') flushList();
          listType = 'ol';
          listItems.push(ordered[1]);
          continue;
        }

        flushList();
        paragraph.push(line.trim());
      }

      if (inCode) flushCode();
      flushParagraph();
      flushList();
      return html.join('');
    };

    const updateLivePreview = () => {
      liveTitle.textContent = titleInput.value.trim() || 'Untitled announcement';
      liveDescription.textContent = descriptionInput.value.trim();

      const date = dateInput.value ? new Date(dateInput.value) : null;
      const categories = selectedCategories();
      const meta = [];
      if (date && !Number.isNaN(date.getTime())) {
        meta.push(new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date));
      }
      if (categories.length) meta.push(categories.join(' · '));
      liveMeta.textContent = meta.join(' — ');

      const body = bodyInput.value.trim();
      if (!body) {
        liveBody.innerHTML = '<p class="publisher-preview-empty">Start writing to see the rendered preview.</p>';
      } else {
        liveBody.innerHTML = renderMarkdown(body);
      }
    };

    const setEditorView = (view) => {
      const allowed = new Set(['write', 'split', 'preview']);
      const next = allowed.has(view) ? view : 'write';
      composePanels.dataset.view = next;
      for (const button of viewButtons) {
        const active = button.dataset.view === next;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      if (next !== 'write') updateLivePreview();
    };

    const replaceSelection = (before, after = before, placeholder = '') => {
      const start = bodyInput.selectionStart;
      const end = bodyInput.selectionEnd;
      const selected = bodyInput.value.slice(start, end) || placeholder;
      bodyInput.setRangeText(`${before}${selected}${after}`, start, end, 'end');
      bodyInput.focus();
      saveDraft();
      updateLivePreview();
    };

    const prefixSelectedLines = (prefixer) => {
      const start = bodyInput.selectionStart;
      const end = bodyInput.selectionEnd;
      const value = bodyInput.value;
      const lineStart = value.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
      const nextNewline = value.indexOf('\n', end);
      const lineEnd = nextNewline === -1 ? value.length : nextNewline;
      const block = value.slice(lineStart, lineEnd);
      const lines = block.split('\n');
      const replacement = lines.map((line, index) => `${prefixer(index)}${line}`).join('\n');
      bodyInput.setRangeText(replacement, lineStart, lineEnd, 'select');
      bodyInput.focus();
      saveDraft();
      updateLivePreview();
    };

    const applyFormat = (format) => {
      switch (format) {
        case 'h2':
          prefixSelectedLines(() => '## ');
          break;
        case 'bold':
          replaceSelection('**', '**', 'bold text');
          break;
        case 'italic':
          replaceSelection('*', '*', 'italic text');
          break;
        case 'link': {
          const selected = bodyInput.value.slice(bodyInput.selectionStart, bodyInput.selectionEnd) || 'link text';
          const url = window.prompt('Link URL (https://… or site-relative /path/):', 'https://');
          if (!url) return;
          replaceSelection('[', `](${url})`, selected);
          break;
        }
        case 'image': {
          const url = window.prompt('Image URL (https://… or site-relative /media/…):', '/media/');
          if (!url) return;
          const alt = window.prompt('Image description (alt text):', 'Image') || 'Image';
          replaceSelection(`![${alt}](`, ')', url);
          break;
        }
        case 'bullets':
          prefixSelectedLines(() => '- ');
          break;
        case 'numbers':
          prefixSelectedLines((index) => `${index + 1}. `);
          break;
        case 'quote':
          prefixSelectedLines(() => '> ');
          break;
        case 'code':
          replaceSelection('`', '`', 'code');
          break;
        case 'codeblock':
          replaceSelection('```\n', '\n```', 'code');
          break;
      }
    };

    const setAuthenticated = (session) => {
      authStatus.textContent = `Signed in as GitHub user @${session.login}.`;
      loginLink.hidden = true;
      logoutButton.hidden = false;
      editor.hidden = false;
    };

    const setSignedOut = (message = 'Sign in with GitHub to publish announcements.') => {
      authStatus.textContent = message;
      loginLink.hidden = false;
      logoutButton.hidden = true;
      editor.hidden = true;
    };

    const loadSession = async () => {
      try {
        const response = await fetch(`${API_ROOT}?action=session`, {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
        });

        if (response.status === 401) {
          setSignedOut();
          return;
        }

        if (!response.ok) {
          setSignedOut('Publisher API is not configured on this server yet.');
          return;
        }

        const session = await response.json();
        if (session.authenticated) setAuthenticated(session);
        else setSignedOut();
      } catch {
        setSignedOut('Publisher API is not configured on this server yet.');
      }
    };

    if (ready) {
      restoreDraft();

      form.addEventListener('input', () => {
        saveDraft();
        updateLivePreview();
      });
      form.addEventListener('change', () => {
        saveDraft();
        updateLivePreview();
      });

      for (const button of viewButtons) {
        button.addEventListener('click', () => setEditorView(button.dataset.view || 'write'));
      }

      for (const button of formatButtons) {
        button.addEventListener('click', () => applyFormat(button.dataset.format || ''));
      }

      titleInput.addEventListener('blur', () => {
        if (!slugInput.value.trim()) slugInput.value = slugify(titleInput.value);
        saveDraft();
      });

      sourceButton.addEventListener('click', () => {
        try {
          previewCode.textContent = generatedMarkdown();
          preview.open = true;
          preview.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch {
          result.textContent = 'Enter a valid publication date before previewing.';
        }
      });

      logoutButton.addEventListener('click', async () => {
        await fetch(`${API_ROOT}?action=logout`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        }).catch(() => {});
        setSignedOut();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        result.textContent = '';

        if (!form.reportValidity()) return;

        const payload = payloadForPublish();
        if (!payload.title || !payload.body) return;

        const confirmed = window.confirm(
          `Publish “${payload.title}” to the PEPEPOW GitHub main branch?\n\nThis creates a new public announcement file.`,
        );
        if (!confirmed) return;

        const publishButton = document.querySelector('#publisher-publish-button');
        publishButton.disabled = true;
        publishButton.textContent = 'Publishing…';

        try {
          const response = await fetch(`${API_ROOT}?action=publish`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json().catch(() => ({}));

          if (response.status === 401) {
            setSignedOut('Your session expired. Sign in again before publishing.');
            return;
          }

          if (!response.ok) {
            result.textContent = data.error || 'Publication failed.';
            return;
          }

          localStorage.removeItem(DRAFT_KEY);
          result.replaceChildren();

          const message = document.createElement('span');
          message.textContent = 'Published to GitHub. ';

          const commitLink = document.createElement('a');
          commitLink.href = data.commit_url;
          commitLink.textContent = 'View commit';
          commitLink.target = '_blank';
          commitLink.rel = 'noopener noreferrer';

          const pageLink = document.createElement('a');
          pageLink.href = data.public_path;
          pageLink.textContent = 'Open announcement';
          pageLink.style.marginLeft = '1rem';

          result.append(message, commitLink, pageLink);

          form.reset();
          dateInput.value = localDateTimeValue();
          preview.open = false;
          previewCode.textContent = '';
          setEditorView('write');
          updateLivePreview();
        } catch {
          result.textContent = 'Publication failed because the publisher API could not be reached.';
        } finally {
          publishButton.disabled = false;
          publishButton.textContent = 'Publish';
        }
      });

      updateLivePreview();
      void loadSession();
    }
